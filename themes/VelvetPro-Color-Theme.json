  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7A6562", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Operators (muted)",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#B06C76" }
    },
    {
      "name": "Word-like operators (new, typeof, and, or...)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Punctuation (muted)",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#B06C76" }
    },
    {
      "name": "String quote punctuation",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": { "foreground": "#F0C0B8" }
    },
    {
      "name": "Template expression and preprocessor punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#F0C0B8" }
    },
    {
      "name": "Code inside template strings",
      "scope": ["meta.template.expression", "meta.embedded"],
      "settings": { "foreground": "#E3D6C3" }
    },
    {
      "name": "Regex, escapes, format placeholders",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": { "foreground": "#F0868F" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#FFEBD6" }
    },
    {
      "name": "Variables, parameters, properties",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#E3D6C3" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language"],
      "settings": { "foreground": "#E8404A", "fontStyle": "italic" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": { "foreground": "#F0868F" }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": { "foreground": "#C9808A" }
    },
    {
      "name": "HTML / XML / JSX tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Tag brackets (muted)",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#B06C76" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C9808A" }
    },
    {
      "name": "JSX / TSX components",
      "scope": ["support.class.component"],
      "settings": { "foreground": "#C9808A" }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#F0868F" }
    },
    {
      "name": "CSS class and id selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#F0868F" }
    },
    {
      "name": "CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#C9808A" }
    },
    {
      "name": "CSS custom properties",
      "scope": [
        "variable.css",
        "variable.argument.css",
        "support.type.custom-property"
      ],
      "settings": { "foreground": "#C9808A", "fontStyle": "italic" }
    },
    {
      "name": "CSS property values",
      "scope": ["support.constant.property-value.css"],
      "settings": { "foreground": "#E3D6C3" }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "#C9808A", "fontStyle": "italic" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#C0606A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FFEBD6", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#E3D6C3", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": { "foreground": "#F0C0B8" }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": { "foreground": "#C9525D" }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#B06C76", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list bullets",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Diff: added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#FFEBD6" }
    },
    {
      "name": "Diff: removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#E8404A" }
    },
    {
      "name": "Diff: changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#F0C0B8" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF5A5F" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#F0C0B8", "fontStyle": "strikethrough" }
    }
  ],

  "semanticTokenColors": {
    "function": "#F0868F",
    "method": "#F0868F",
    "class": "#C9808A",
    "interface": "#C9808A",
    "enum": "#C9808A",
    "typeParameter": "#C9808A",
    "namespace": "#C9808A",
    "enumMember": "#FFEBD6",
    "macro": "#F0C0B8",
    "decorator": "#C9808A"
  }
}